#!/usr/bin/env bash
set -euo pipefail

repo="$(git rev-parse --show-toplevel)"
runtime="${CONTAINER_RUNTIME:-podman}"
target="${1:-senshac-media-runner:candidate}"
archive="$(nix build "$repo#ociImage" --no-link --print-out-paths)"
"$runtime" load --input "$archive"
"$runtime" tag senshac-media-runner:candidate "$target"
